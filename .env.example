# Netravati + Kudremukh weekend monitor.
# Format: district_id:trek_id:display name
TREK_TARGETS=17:112:Kudremukha Trek;24:113:Nethravathi Trek

# Aranya Vihaara allows only the next 15 days, so the script checks weekend
# dates inside that rolling window.
WEEKENDS_ONLY=true
CHECK_NEXT_DAYS=15

# Watch only 300-capacity slots such as 0/300 -> 1/300.
CAPACITY_FILTER=300
SHOW_BLOCKED_DATES=false

# Strict mode: the first run records the baseline quietly. It notifies only
# after it has previously seen 0 and later sees a positive number.
ALERT_ON_FIRST_POSITIVE=false
ALERT_ON_EVERY_POSITIVE=false
ALERT_ON_UNNOTIFIED_POSITIVE=true

# For continuous local monitoring.
CHECK_INTERVAL_SECONDS=300
# LOOP=true

# WhatsApp option 1: Twilio WhatsApp.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
# Production WhatsApp often needs an approved template outside the 24-hour
# customer service window. If you use a Twilio Content Template, set:
# TWILIO_CONTENT_SID=HX...
#
# The checker fills template variables automatically:
# {{1}} trek name, {{2}} date, {{3}} slot count.

# WhatsApp option 2: Meta WhatsApp Cloud API.
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v20.0
# WHATSAPP_TO=91XXXXXXXXXX

# Optional: custom webhook that accepts {"text": "..."}.
# WHATSAPP_WEBHOOK_URL=
